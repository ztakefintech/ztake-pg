# JWT Secret for vendor authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API Key Secret for bot authentication
API_KEY_SECRET=your-super-secret-api-key-change-in-production

# Database path (optional, defaults to payment_tracking.db)
DATABASE_PATH=./payment_tracking.db

# Next.js configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=admin-secret-key-change-in-production-2024